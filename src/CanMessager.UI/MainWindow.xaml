<Window x:Class="CanMessager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CanMessager.UI.ViewModels"
        mc:Ignorable="d"
        Title="CANoe HEX ReFlash Manager" Height="760" Width="960"
        FontFamily="Segoe UI" Background="#FAFAFA">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="EnumKoTemplate">
            <TextBlock Text="{Binding Converter={x:Static vm:EnumKoreanConverter.Instance}}"/>
        </DataTemplate>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="8,6"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ① 역할 및 연결 설정 -->
        <GroupBox Grid.Row="0" Header="① 역할 및 연결 설정">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="역할" Style="{StaticResource Label}"/>
                    <ComboBox Width="150" Margin="0,0,16,4"
                              ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole}"
                              ItemTemplate="{StaticResource EnumKoTemplate}"
                              IsEnabled="{Binding IsConnected, Converter={x:Static vm:BoolNot.Instance}}"/>

                    <TextBlock Text="인터페이스" Style="{StaticResource Label}"/>
                    <ComboBox Width="140" Margin="0,0,16,4"
                              ItemsSource="{Binding HardwareTypes}"
                              SelectedItem="{Binding SelectedHardware}"
                              ItemTemplate="{StaticResource EnumKoTemplate}"
                              IsEnabled="{Binding IsConnected, Converter={x:Static vm:BoolNot.Instance}}"/>

                    <TextBlock Text="채널" Style="{StaticResource Label}"/>
                    <ComboBox Width="240" Margin="0,0,6,4"
                              ItemsSource="{Binding AvailableChannels}"
                              SelectedItem="{Binding SelectedChannel}"
                              DisplayMemberPath="Display"
                              IsEnabled="{Binding IsConnected, Converter={x:Static vm:BoolNot.Instance}}"/>
                    <Button Content="스캔" MinWidth="56" Margin="0,0,16,4" Command="{Binding ScanCommand}"/>

                    <TextBlock Text="S→R ID(hex)" Style="{StaticResource Label}"
                               ToolTip="송신처→수신처 데이터 ID. 표준 11-bit는 최대 0x7FF. 양쪽 PC에 동일하게 입력하세요."/>
                    <TextBox Width="86" Margin="0,0,16,4" Text="{Binding TxCanIdHex}"
                             IsEnabled="{Binding IsConnected, Converter={x:Static vm:BoolNot.Instance}}"/>

                    <TextBlock Text="R→S ID(hex)" Style="{StaticResource Label}"
                               ToolTip="수신처→송신처 응답 ID. 표준 11-bit는 최대 0x7FF. 양쪽 PC에 동일하게 입력하세요."/>
                    <TextBox Width="86" Margin="0,0,16,4" Text="{Binding RxCanIdHex}"
                             IsEnabled="{Binding IsConnected, Converter={x:Static vm:BoolNot.Instance}}"/>

                    <CheckBox Content="확장 ID(29-bit)" Margin="0,0,16,4" VerticalAlignment="Center"
                              IsChecked="{Binding ExtendedId}"
                              ToolTip="체크 해제 시 표준 11-bit ID 사용(헤더 오버헤드↓, 처리량↑)."
                              IsEnabled="{Binding IsConnected, Converter={x:Static vm:BoolNot.Instance}}"/>

                    <Button Content="연결" Command="{Binding ConnectCommand}"/>
                    <Button Content="해제" Command="{Binding DisconnectCommand}"/>
                </WrapPanel>
                <DockPanel Margin="0,4,0,0">
                    <CheckBox DockPanel.Dock="Right" Content="CAN 통신 트레이스"
                              IsChecked="{Binding EnableTracing}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RoleHint}" Foreground="#0A6CBC" FontStyle="Italic" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <!-- ② 송신 / 수신 설정 (역할에 따라 표시) -->
        <StackPanel Grid.Row="1">
            <!-- 송신 패널 -->
            <GroupBox Header="② 파일 전송 (송신)"
                      Visibility="{Binding ShowSendPanel, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="파일" Style="{StaticResource Label}"/>
                        <TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding SelectedFilePath}" IsReadOnly="True"/>
                        <Button Grid.Column="2" Content="찾아보기..." Command="{Binding BrowseCommand}"/>
                        <Button Grid.Column="3" Content="전송" Command="{Binding SendCommand}"
                                Background="#2D7D46" Foreground="White" FontWeight="SemiBold"/>
                    </Grid>
                    <Border Margin="0,8,0,0" Padding="10,8" Background="#F0F4F8" CornerRadius="4"
                            Visibility="{Binding HasFileSummary, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="선택한 파일 요약" FontWeight="SemiBold" Foreground="#2D5070" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding FileSummary}" Foreground="#333" FontFamily="Consolas" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <!-- 수신 설정 패널 -->
            <GroupBox Header="② 수신 설정"
                      Visibility="{Binding ShowReceivePanel, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="저장 폴더" Style="{StaticResource Label}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,6" Text="{Binding SaveDirectory}"
                             IsEnabled="{Binding IsConnected, Converter={x:Static vm:BoolNot.Instance}}"/>
                    <Button Grid.Row="0" Grid.Column="2" Margin="0,0,0,6" Content="폴더 선택..."
                            Command="{Binding BrowseSaveFolderCommand}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="저장 파일명" Style="{StaticResource Label}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SaveFileNameOverride}"
                             IsEnabled="{Binding IsConnected, Converter={x:Static vm:BoolNot.Instance}}"
                             ToolTip="비우면 송신측 원본 파일명을 사용합니다. 확장자를 생략하면 원본 확장자가 적용됩니다."/>
                </Grid>
            </GroupBox>
        </StackPanel>

        <!-- ③ 진행 상황 -->
        <GroupBox Grid.Row="2" Header="③ 진행 상황">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0"
                            Visibility="{Binding ShowSendPanel, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="송신" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ProgressBar Height="22" Minimum="0" Maximum="100" Value="{Binding SendPercent, Mode=OneWay}"/>
                    <TextBlock Text="{Binding SendStatus}" Margin="0,4,0,0" Foreground="#555"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0"
                            Visibility="{Binding ShowReceivePanel, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="수신" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ProgressBar Height="22" Minimum="0" Maximum="100" Value="{Binding ReceivePercent, Mode=OneWay}"/>
                    <TextBlock Text="{Binding ReceiveStatus}" Margin="0,4,0,0" Foreground="#555"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 로그 / 트레이스 / 수신 목록 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="활동" Padding="4">
                <TabControl>
                    <TabItem Header="로그">
                        <ListBox ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" BorderThickness="0"/>
                    </TabItem>
                    <TabItem Header="CAN 트레이스">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="4">
                                <Button DockPanel.Dock="Right" Content="지우기" MinWidth="60"
                                        Command="{Binding ClearTraceCommand}"/>
                                <CheckBox Content="트레이스 활성화" IsChecked="{Binding EnableTracing}"
                                          VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding TraceEntries}" FontFamily="Consolas" FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" BorderThickness="0"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="수신한 파일"
                      Visibility="{Binding ShowReceivePanel, Converter={StaticResource BoolToVis}}">
                <ListBox ItemsSource="{Binding ReceivedFiles}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                <TextBlock Foreground="#777" FontSize="11">
                                    <Run Text="{Binding Size}"/>
                                    <Run Text="  ·  "/>
                                    <Run Text="{Binding HashStatus}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding SavedPath}" Foreground="#999" FontSize="10"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>

        <!-- 상태바 -->
        <Border Grid.Row="4" Background="#ECECEC" Padding="10,5" Margin="8,0,8,4" CornerRadius="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="상태: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ConnectionStatus}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
